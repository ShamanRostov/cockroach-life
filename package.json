{
  "name": "cockroach-life",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "smoke": "node scripts/smoke-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "process:assets": "node scripts/process-assets.mjs",
    "deploy:assets": "powershell -ExecutionPolicy Bypass -File scripts/deploy-assets.ps1 && node scripts/process-assets.mjs",
    "verify": "node scripts/run-verify.mjs",
    "build": "tsc && vite build",
    "build:staging": "tsc && vite build --mode staging",
    "build:yandex": "tsc && vite build --mode yandex",
    "preview": "vite preview",
    "electron:dev": "npm run build && cd electron && npm install && npm start",
    "electron:build": "npm run build && cd electron && npm install && npm run dist",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "audit:graphics": "node scripts/graphics-audit.mjs"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
